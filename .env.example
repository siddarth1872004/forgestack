# Use the Supabase *Transaction pooler* string (port 6543). The direct db.*.supabase.co host is IPv6-only and hangs on Vercel.
# Required: server-only Supabase connection string. Never prefix this with NEXT_PUBLIC.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Required: password used to sign in as the single administrator.
ADMIN_PASSWORD=choose-a-long-unique-password
